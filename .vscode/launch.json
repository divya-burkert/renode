{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Renode run",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Run Renode",
            "postDebugTask": "Close Renode",
            "miDebuggerServerAddress": "localhost:3333",
            "cwd": "${workspaceRoot}",
            "miDebuggerPath": "arm-none-eabi-gdb.exe",
            "program": "${workspaceRoot}/cmake-build-GNU_STM32U5_Debug/UserArea/UserArea.elf"
        },
        {
            "name": "Renode attach",
            "type": "cppdbg",
            "request": "launch",
            "miDebuggerServerAddress": "localhost:3333",
            "cwd": "${workspaceRoot}",
            "miDebuggerPath": "arm-none-eabi-gdb.exe",
            "program": "${workspaceRoot}/cmake-build-GNU_STM32U5_Debug/UserArea/UserArea.elf"
        },
        {
            "name": "Cortex Debug",
            "cwd": "${workspaceRoot}",
            "executable": "cmake-build-GNU_STM32U5_Debug/UserArea/UserArea.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "jlink",
            "serverpath": "C:/toolchain/tools/JLink/JLinkGDBServerCL.exe",
            "device": "STM32U585QI",
            "showDevDebugOutput": true
        },
        {
            "name": "Cortex Debug ST-Link",
            "cwd": "${workspaceRoot}",
            "executable": "cmake-build-GNU_STM32U5_Debug/UserArea/UserArea.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "stlink",
            "serverpath": "C:/toolchain/tools/STLinkGDBServer/ST-LINK_gdbserver.exe",
            "device": "STM32U585QI",
            "showDevDebugOutput": true
        },
        {
            "name": "(ctest) Launch",
            "type": "cppdbg",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "program": "${cmake.testProgram}",
            "MIMode": "gdb",
            "miDebuggerPath": "c:\\toolchain\\tools\\mingw64\\bin\\gdb.exe",
            "args": [
                "${cmake.testArgs}"
            ],
        }
    ]
}